        {
            "label": "debug deploy run logcat",
            "type": "shell",
            "command": "bash",//
            "args": [
                "-c",
                "script=\"tmpscript.sh\" ; echo \"\" >$script ; for a in \"$@\"; do echo $a >> \"$script\" ; done ; bash \"$script\" ; rm \"$script\"",
                "--",
                "source ./venv/bin/activate",
                "cd EyeWriter/",
                "( rm ./buildlog.txt || true) && buildozer android debug | tee ./buildlog.txt",
                "if [ ${input:should-wait} -eq 1 ] ; then",
                "  echo \"Press Enter to continue...\" ; read",
                "fi",
                "source ./venv/bin/activate ; cd EyeWriter/ ; buildozer android deploy run logcat | grep \"python\"",
            ],
            "options": {
                "env": {
                    
                }
            },
            "problemMatcher": [],
        }
    ],
    "inputs": [
        {
            "id": "should-wait",
            "description": "Ask input to continue",
            "type": "pickString",
            "options": ["0", "1"],
            "default": "0"
        }
    ]
